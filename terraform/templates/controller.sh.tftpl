#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y git curl python3-venv

curl -fsSL https://s3.amazonaws.com/session-manager-downloads/plugin/latest/ubuntu_64bit/session-manager-plugin.deb \
  -o /tmp/session-manager-plugin.deb
dpkg -i /tmp/session-manager-plugin.deb
rm -f /tmp/session-manager-plugin.deb

sudo -u ubuntu -H git clone ${repository_url} /home/ubuntu/final-project-example

python3 -m venv /opt/ansible
/opt/ansible/bin/pip install --upgrade pip
/opt/ansible/bin/pip install -r /home/ubuntu/final-project-example/ansible/requirements.txt
for bin in /opt/ansible/bin/ansible*; do
  ln -sf "$bin" /usr/local/bin/
done

cd /home/ubuntu/final-project-example/ansible
sudo -u ubuntu -H ansible-galaxy install -r requirements.yml
